# Copy to .env for a local run. Never commit .env.
HOST=127.0.0.1
PORT=3000
# Extra hostnames allowed in Host and Origin, comma separated, for example desk.example.com
ALLOWED_HOSTS=
# Path to the shop's own policy JSON. Defaults to policy.example.json.
REFUND_POLICY_FILE=
# Path to the PayPal sandbox key file. Defaults to ~/.config/refund-desk/sandbox.env (mode 600).
# Never put the keys themselves in .env or in this repo.
PAYPAL_CREDENTIALS_FILE=
